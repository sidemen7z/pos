{
  "name": "@aiseserve/cashier-exe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": { "dev": "vite --port 5176", "build": "tsc --noEmit && vite build", "electron": "electron ." },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@supabase/supabase-js": "^2.45.0",
    "@aiseserve/core": "workspace:*",
    "@aiseserve/ui": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0"
  },
  "build": {
    "appId": "com.aise360.aiseserve.cashier",
    "productName": "Aise Bites Cashier",
    "directories": { "output": "release" },
    "files": ["dist/**", "electron-main.cjs", "preload.cjs", "build/icon.ico", "build/icon.png", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.ico", "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "shortcutName": "Aise Bites Cashier", "installerIcon": "build/icon.ico", "uninstallerIcon": "build/icon.ico" }
  }
}
